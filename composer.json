{
    "name": "artemeon/orm",
    "license": "MIT",
    "type": "library",
    "description": "",
    "scripts": {
        "phpstan": "php ./vendor/bin/phpstan analyse --memory-limit=4G",
        "pint": "./vendor/bin/pint --test -v --parallel",
        "pint:fix": "./vendor/bin/pint -v --parallel",
        "test": "./vendor/bin/pest --parallel",
        "test:coverage": "XDEBUG_MODE=coverage ./vendor/bin/pest --coverage --parallel --min=84.6",
        "test:type-coverage": "XDEBUG_MODE=coverage ./vendor/bin/pest --type-coverage --min=100"
    },
    "authors": [
        {
            "name": "ARTEMEON Management Partner GmbH",
            "email": "development@artemeon.de"
        }
    ],
    "autoload": {
        "psr-4": {
            "Artemeon\\Orm\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Artemeon\\Orm\\Tests\\": "tests/"
        }
    },
    "require": {
        "artemeon/database": "^4.0.1",
        "doctrine/collections": "^2.0",
        "php": ">=8.4",
        "psr/simple-cache": "^3.0"
    },
    "require-dev": {
        "laravel/pint": "^1.20.0",
        "pestphp/pest": "^v3.7",
        "pestphp/pest-plugin-type-coverage": "^3.2",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan": "^2.1.2",
        "phpstan/phpstan-mockery": "^2.0.0",
        "rector/rector": "^2.0.7",
        "symfony/cache": "^6.0"
    },
    "config": {
        "process-timeout": 0,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    }
}
